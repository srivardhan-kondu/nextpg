# ─────────────────────────────────────────────────────────────
# NextPG — environment variables
# Copy to .env.local for development. Never commit a filled-in copy.
# lib/env.ts validates these at boot; a missing required value fails fast.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Neon: use the POOLED connection string for DATABASE_URL and the
# DIRECT (non-pooled) one for DIRECT_URL, which migrations need.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/nextpg?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/nextpg?sslmode=require"

# ── Auth (required) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Your canonical origin. Required in production; inferred locally.
AUTH_URL="http://localhost:3000"

# ── Google OAuth (REQUIRED — it is the only sign-in method) ──
# Google Cloud Console → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Web application.
#
# Authorised redirect URI (must match exactly, no trailing slash):
#   http://localhost:3000/api/auth/callback/google      (development)
#   https://yourdomain.in/api/auth/callback/google      (production)
#
# Authorised JavaScript origins are not needed — NextAuth uses a server-side
# flow. While the OAuth consent screen is in "Testing", only accounts listed
# under Test users can sign in.
#
# Without these, nobody can sign in and the login page says so.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Razorpay (optional — checkout hides when unset) ──────────
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks. Set this to the secret you chose there.
# Webhook URL: {AUTH_URL}/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=""
# The public key id, exposed to the browser for the checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Counseling assistant (optional — the panel hides when unset) ──
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Rate limiting ────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without Upstash the limiter falls back to an
# in-process map, which is per-lambda and therefore not a real limit.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prediction engine: rule-based | historical | ml
# `historical` and `ml` currently delegate to `rule-based`.
PREDICTION_PROVIDER="rule-based"

# Set to "true" only for CI builds without secrets. Never in production runtime.
# SKIP_ENV_VALIDATION="false"
